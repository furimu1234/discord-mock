{
  "name": "@discord-mock/sample-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/bot.ts src/run.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outdir=dist",
    "test": "node --test tests/*.test.mjs",
    "start": "node dist/run.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@discord-mock/client-js": "workspace:*",
    "discord.js": "14.27.0"
  }
}
