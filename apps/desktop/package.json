{
  "name": "@discord-mock/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "description": "Local Discord mock desktop controller",
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node scripts/start.ts",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dir",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "43.7.11",
    "electron-builder": "26.18.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  },
  "build": {
    "appId": "dev.discordmock.desktop",
    "productName": "Discord Mock",
    "directories": {
      "output": "../../release/desktop"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server/dist/server.cjs",
        "to": "discord-mock-server.cjs"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "discord-mock-${version}-windows-${arch}.${ext}"
    },
    "mac": {
      "artifactName": "discord-mock-${version}-macos-${arch}.${ext}",
      "target": [
        "dir"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "artifactName": "discord-mock-${version}-linux-${arch}.${ext}"
    },
    "asar": true,
    "executableName": "discord-mock"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/furimu1234/discord-mock.git"
  },
  "author": "discord-mock contributors",
  "allowScripts": {
    "electron@43.7.11": true,
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true
  }
}
