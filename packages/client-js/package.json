{
  "name": "@discord-mock/client-js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {".": {"types": "./dist/index.d.ts", "default": "./dist/index.js"}},
  "files": ["dist", "README.md"],
  "engines": {"node": ">=24.17.0"},
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.mjs"
  },
  "devDependencies": {"discord.js": "14.27.0", "@sapphire/framework": "5.5.1"}
}
