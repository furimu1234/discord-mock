{
  "name": "@ex/bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/mock.js",
  "exports": {
    ".": "./dist/mock.js"
  },
  "scripts": {
    "build": "esbuild src/mock.ts src/runMock.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outdir=dist --out-extension:.js=.mjs && esbuild src/mock.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist/mock.js",
