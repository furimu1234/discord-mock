{
  "name": "@discord-mock/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node24 --format=cjs --loader:.css=text --outfile=dist/discord-mock.cjs && esbuild src/server.ts --bundle --platform=node --target=node24 --format=cjs --loader:.css=text --outfile=dist/server.cjs",
    "dev": "node dist/discord-mock.cjs",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0"
  }
}
