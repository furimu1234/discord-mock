{
  "name": "@discord-mock/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && esbuild src/browser.ts --bundle --platform=browser --target=es2022 --format=iife --outfile=dist/browser.js.txt",
    "test": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json && node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json"
  }
}
