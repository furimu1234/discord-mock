{
  "name": "@discord-mock/level-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm test:bot",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome lint --error-on-warnings packages scripts tests biome.json tsconfig.json package.json",
    "app": "tsx --tsconfig packages/bot/tsconfig.json packages/bot/src/testClient.ts --app",
    "start": "tsx --tsconfig packages/bot/tsconfig.json packages/bot/src/testClient.ts --bot",
    "demo": "tsx --tsconfig tsconfig.json scripts/demo.ts",
    "test:level": "pnpm test:bot",
    "test:level:web": "pnpm test:bot:web",
    "test:bot": "tsx --tsconfig packages/bot/tsconfig.json packages/bot/src/testClient.ts --test",
    "test:bot:web": "tsx --tsconfig packages/bot/tsconfig.json packages/bot/src/testClient.ts --test-web"
  },
  "dependencies": {
    "dismock": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "discord.js": "14.27.0",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
