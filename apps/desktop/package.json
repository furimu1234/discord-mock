{
  "name": "@discord-mock/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.cjs",
  "description": "Local Discord mock desktop controller",
  "scripts": {
    "build": "esbuild src/main.ts src/preload.ts src/terminal-preload.ts --bundle --platform=node --target=node24 --format=cjs --outdir=dist --out-extension:.js=.cjs --external:electron && esbuild src/terminal.ts --bundle --platform=browser --target=es2022 --format=iife --outfile=dist/terminal.js && node -e \"require('node:fs').copyFileSync('src/terminal.html','dist/terminal.html')\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron .",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dir",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  },
  "build": {
    "appId": "dev.discordmock.desktop",
    "productName": "Discord Mock",
    "directories": {
      "output": "../../release/desktop"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server/dist/server.cjs",
        "to": "discord-mock-server.cjs"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "discord-mock-${version}-windows-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dir"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "artifactName": "discord-mock-${version}-linux-${arch}.${ext}",
      "desktopName": "discord-mock",
      "syncDesktopName": true
    },
    "asar": true,
    "executableName": "discord-mock"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/furimu1234/discord-mock.git"
  },
  "author": "discord-mock contributors"
}
